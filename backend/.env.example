# Copy this file to ".env" (same folder) and fill in the values.
# NEVER commit the real .env file or share it with anyone.

PORT=5000
NODE_ENV=development

# Your Neon (Postgres) connection string, from the Neon dashboard.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# A long random string. Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30m

# The address of the website. Required when NODE_ENV=production.
FRONTEND_URL=http://localhost:5173

# Text messages (TextBee). Leave SMS_DRY_RUN=true to test without sending anything.
SMS_DRY_RUN=true
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

GROUP_NAME=Manase Village Bank
CURRENCY=MWK

# After this many wrong passwords the account locks for LOCK_MINUTES.
MAX_LOGIN_ATTEMPTS=3
LOCK_MINUTES=5
